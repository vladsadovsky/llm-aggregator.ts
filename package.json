{
  "name": "llm-aggregator",
  "version": "2.1.0",
  "license": "MIT",
  "author": {
    "name": "Vlad Sadovsky",
    "email": "sadovskyvlad@gmail.com"
  },
  "description": "LLM Aggregator - Organize and search LLM conversation Q&A pairs",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "set VITE_DEBUG_LEVEL=warning&& vite --config vite.config.mts",
    "dev:code": "if /I \"%TERM_PROGRAM%\"==\"vscode\" (set VITE_DEBUG_LEVEL=debug&& vite --config vite.config.mts) else (vite --config vite.config.mts)",
    "dev:debug": "set VITE_DEBUG_LEVEL=debug&& vite --config vite.config.mts",
    "dev:server": "vite --config vite.config.server.mts --host localhost --port 5173 --no-open",
    "build": "vue-tsc --noEmit && vite build",
    "check": "npm run check:line-endings && npm run check:dependencies && npm run typecheck && eslint . && npm test && vite build && npm audit --omit=dev --audit-level=high",
    "check:dependencies": "node scripts/check-dependency-baseline.mjs",
    "check:line-endings": "node scripts/check-line-endings.mjs",
    "fix:line-endings": "node scripts/check-line-endings.mjs --fix",
    "build:icons": "echo 'Generate icons from build/llm-aggregator.svg using electron-icon-builder or online tools. Output to public/icons. See build/README.md'",
    "electron:dev": "vite --config vite.config.mts",
    "electron:prod": "set NODE_ENV=production&& npm run build && electron .",
    "electron:build": "npm run check && electron-builder --config electron-builder.yml",
    "electron:build:mac": "npm run check && electron-builder --config electron-builder.yml --mac",
    "electron:build:win": "npm run check && electron-builder --config electron-builder.yml --win",
    "electron:build:msi": "npm run check && electron-builder --config electron-builder.yml --win msi",
    "electron:build:linux": "npm run check && electron-builder --config electron-builder.yml --linux",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=electron",
    "test:e2e:smoke": "playwright test --project=electron --grep @smoke",
    "test:e2e:debug": "playwright test --project=electron --debug",
    "test:e2e:ui": "playwright test --project=electron --ui",
    "test:e2e:report": "playwright show-report",
    "test:visual": "playwright test tests/visual --project=electron",
    "test:visual:update": "playwright test tests/visual --project=electron --update-snapshots"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.9.0",
    "js-yaml": "^4.1.0",
    "lucide-vue-next": "^0.563.0",
    "markdown-it": "^14.0.0",
    "openai": "^6.29.0",
    "pinia": "^2.1.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vue": "^3.4.0",
    "yauzl": "^2.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.2",
    "@types/js-yaml": "^4.0.0",
    "@types/markdown-it": "^14.0.0",
    "@types/turndown": "^5.0.6",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.5.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.0"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true
  }
}
