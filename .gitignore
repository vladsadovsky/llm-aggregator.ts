node_modules/
dist/
dist-electron/
release/
*.local
.DS_Store

# Tool generated data
playwright-report/
coverage/
test-results

# Claude Code settings. Track the shareable project config (permission
# allow-list, dev-preview launch config); keep personal/transient files out.
.claude/*
!.claude/settings.json
!.claude/launch.json


# Runtime data files (user-specific)
# Leading slash anchors these to the repo root: in dev the data directory
# defaults to the CWD, so only the top-level archive/ is user data. An unanchored
# "archive/" also matched electron/services/import/archive/ and silently kept
# source files out of commits.
/settings.json
/threads.json
/tag-dictionary.json
/archive/

.history
